{
  "regions": [
    "sin1"
  ],
  "buildCommand": "npm run build",
  "functions": {
    "api/*.js": {
      "includeFiles": "public/{item,event}.html"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://pbs.twimg.com; media-src 'self' https://video.twimg.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/e/:slug",
      "destination": "/api/meta/e/:slug"
    },
    {
      "source": "/t/:id",
      "destination": "/api/meta/t/:id"
    }
  ]
}
