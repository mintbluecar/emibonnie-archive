// @ts-check
/**
 * The /__dash__ page. Scaffolded by `npm run new page __name__`, which
 * also listed it in src/pages.js (the build emits its rewrite, and no
 * kind can claim its path) and added its copy keys to
 * src/site/copyDefaults.json. It reads `GET /api/__dash__`
 * (`npm run new route __name__` makes that route).
 *
 * The rules every page follows (see account.js, the fullest example):
 * - `compose__Pascal__(data)` is pure (data -> SafeHtml), so tests need no DOM;
 * - the chrome is `pageShell` (no search box: only home and the event,
 *   person and translator pages search in place, `components/inlineSearch.js`);
 * - the first paint is `mountPage` (it sets `#app[data-ready]` for e2e),
 *   whether that is the page, its 404 or its load error;
 * - the initial load is wrapped in try/catch: a 404 shows the page's own
 *   not-found state, anything else `mountLoadError` (pageError.js);
 * - `document.title` gets a synchronous default before any fetch;
 * - every refetch goes through `load`, whose sequence guard drops a
 *   response that a newer request has overtaken;
 * - every word comes from `t()`/`tCount()`; markup only through `html`.
 */
import { html } from '../core/html.js';
import { mountPage } from '../core/dom.js';
import { getJson, ApiError } from '../core/api.js';
import { site, t } from '../core/site.js';
import * as pageShell from '../components/pageShell.js';
import * as emptyState from '../components/emptyState.js';
import { mountLoadError } from './pageError.js';

const APP_SELECTOR = 'app';
const API_PATH = '/api/__dash__';

/** @typedef {{ items: string[] }} __Pascal__View TODO move to src/http/contracts.js with the route */

/** @param {__Pascal__View} data @returns {import('../core/html.js').SafeHtml} */
export function compose__Pascal__(data) {
  const list = data.items.length > 0
    ? html`<ul class="c-__dash__">${data.items.map((item) => html`<li class="c-__dash____item">${item}</li>`)}</ul>`
    : emptyState.render({ message: t('__camel__.empty') });
  return pageShell.render({ compact: true, content: html`<h1 class="c-static__title">${t('__camel__.title')}</h1>${list}` });
}

/**
 * Fetches and paints, unless a later `load` started meanwhile (`state.seq`).
 * The first call's failure is the caller's to handle.
 * @param {Element} root @param {{ seq: number }} state
 * @returns {Promise<void>}
 */
export async function load(root, state) {
  state.seq += 1;
  const mine = state.seq;
  /** @type {__Pascal__View} */
  const data = await getJson(API_PATH);
  if (mine !== state.seq) return;
  mountPage(root, compose__Pascal__(data));
}

/** @returns {Promise<void>} */
export async function start() {
  const root = document.getElementById(APP_SELECTOR);
  if (!root) return;
  document.title = `${t('__camel__.title')} · ${site.name}`;
  // The page's one sequence state: every later refetch (a filter, a "more" button, a retry) must
  // call load(root, state) with THIS object, or its guard can't see the newer request.
  const state = { seq: 0 };
  try {
    await load(root, state);
  } catch (err) {
    if (err instanceof ApiError && err.status === 404) {
      mountPage(root, pageShell.render({ compact: true, content: emptyState.render({ message: t('static.notFound') }) }));
      return;
    }
    mountLoadError(root);
  }
}

if (typeof document !== 'undefined') start();
