{
  "name": "fan-archive",
  "version": "0.5.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "pretest": "node scripts/genRegistries.js",
    "test": "node --test \"test/**/*.test.js\"",
    "posttest": "node scripts/checkTreeHash.js",
    "check": "tsc --noEmit -p jsconfig.json && eslint . && node scripts/lintStyles.js",
    "dev": "node scripts/build.js && node scripts/dev.js",
    "dev:watch": "node scripts/devWatch.js",
    "build": "node scripts/build.js",
    "setup": "node scripts/setup.js",
    "doctor": "node scripts/doctor.js",
    "migrate": "node scripts/migrate.js",
    "add": "node scripts/add.js",
    "remap": "node scripts/remap.js",
    "init-site": "node scripts/initSite.js",
    "seed-dev": "node scripts/seedDev.js",
    "pull-prod": "node scripts/pullProd.js",
    "screens": "node scripts/screens.js",
    "e2e": "playwright test && npm run e2e:add",
    "e2e:add": "playwright test -c playwright.add.config.js",
    "e2e:site": "node scripts/e2eSite.js",
    "new": "node scripts/new.js",
    "test:kind": "node --test test/kinds/scaffoldedKind.test.js",
    "import": "node scripts/import.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/functions": "^3.10.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.13.0",
    "stylelint": "17.16.0",
    "typescript": "^7.0.2"
  }
}
